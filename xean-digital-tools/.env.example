# All optional. Defaults shown.
XEAN_RATE_LIMIT=20            # download requests per window per IP
XEAN_RATE_WINDOW_MS=60000
XEAN_MAX_CONCURRENCY=4        # scraper jobs running at once
XEAN_MAX_QUEUE=20             # waiting jobs before 503
XEAN_METHOD_TIMEOUT_MS=30000  # per scraper method
XEAN_TOTAL_TIMEOUT_MS=75000   # across the whole fallback chain
XEAN_CACHE_TTL_MS=30000       # in-memory memo of results (URLs are temporary; never persisted)
XEAN_DNS_CHECK=on             # resolve host and reject private IPs
XEAN_BROWSER_SCRAPERS=auto    # auto|on|off  (savetik, fdown, snapinsta need puppeteer/playwright + Chrome)
XEAN_ADMIN_TOKEN=             # set to enable GET /api/health (send header x-admin-token)
XEAN_DATA_DIR=./data          # history.json location
XEAN_LOG=on
